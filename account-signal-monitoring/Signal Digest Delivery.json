          "conditions": [
            {
              "id": "6430c8ea-f994-4253-8647-f13c43954fbc",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
