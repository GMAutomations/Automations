      "id": "14eff786-f95b-43b2-9dbc-bb1c159244fe",
      "name": "Has Signals to Digest"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst warm = items.filter(i => i.json.score === 'Warm');\nconst cold = items.filter(i => i.json.score === 'Cold');\n\nlet message = `Daily Signal Digest — ${new Date().toISOString().split('T')[0]}\\n`;\nmessage += `${items.length} signal(s) reviewed, ${warm.length} Warm, ${cold.length} Cold\\n\\n`;\n\nif (warm.length > 0) {\n  message += `Warm Signals:\\n`;\n  warm.forEach(i => {\n    message += `- ${i.json.company_name}: ${i.json.signal_description.slice(0, 150)}\\n  ${i.json.source_url}\\n`;\n  });\n  message += `\\n`;\n}\n\nmessage += `Cold signals reviewed: ${cold.length} (no action needed)\\n`;\n\nreturn [{ json: { digest_text: message, ids: items.map(i => i.json.id) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -96
      ],
      "id": "3eed19b6-8f31-4e93-83b0-fa1741a692eb",
      "name": "Format Digest Message"
    },
